{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor", "admin"] },
        "subscriptionTier": { "type": "string", "enum": ["free", "basic", "premium"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Detailed doctor profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "bio": { "type": "string" },
        "rating": { "type": "number" },
        "experienceYears": { "type": "number" },
        "consultationFee": { "type": "number" },
        "photoURL": { "type": "string" },
        "availability": { "type": "object" }
      },
      "required": ["uid", "name", "specialty"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Consultation appointment details",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "dateTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "doctorId", "dateTime", "status"]
    },
    "HealthRecord": {
      "title": "Health Record",
      "description": "Patient medical record",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["diagnosis", "prescription", "test_result", "history"] },
        "date": { "type": "string", "format": "date" },
        "content": { "type": "string" },
        "doctorId": { "type": "string" }
      },
      "required": ["patientId", "title", "type", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/doctors/{doctorId}": {
      "schema": "Doctor",
      "description": "Doctor profiles"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Booked appointments"
    },
    "/health_records/{recordId}": {
      "schema": "HealthRecord",
      "description": "Secure medical history"
    }
  }
}
